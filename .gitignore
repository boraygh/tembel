# --- Xcode / XcodeGen ---
# .xcodeproj üretilen bir dosyadır, repoda tutulmaz. `xcodegen generate` ile
# yeniden oluştur.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# XcodeGen tarafından project.yml'den üretilir.
App/Info.plist

xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# --- Swift Package Manager ---
.build/
.swiftpm/
Package.resolved

# --- macOS / Windows ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editör ---
# VS Code ayarları paylaşılıyor: proje tek tıkla çalışsın ve biçimlendirme
# ikimizde de aynı olsun diye.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/

# Design canvas cikti dosyasi - kaynak .dc.html dosyalarindan uretilir
design/tembel-arayuz.html

# Flutter
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins-dependencies
flutter_app/*.iml
